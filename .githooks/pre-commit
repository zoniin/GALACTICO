#!/bin/sh
# Run from the repo root with the project interpreter, so the hook sees the same
# environment the developer does.
cd "$(git rev-parse --show-toplevel)" || exit 1
PY=".venv/Scripts/python.exe"
[ -x "$PY" ] || PY=".venv/bin/python"
[ -x "$PY" ] || PY="python"

# The licence guard must run AT COMMIT TIME, not whenever someone remembers.
# A 418 MB pickle reached HEAD once because the guard ran earlier in the session
# than the script that wrote the file. Ordering is not a discipline problem.
"$PY" scripts/check_licensing.py --staged || exit 1

# And a commit went in with a failing test because the hook checked licensing and
# nothing else. Use --no-verify deliberately, not by forgetting.
PYTHONPATH=. "$PY" -m pytest -q -x --no-header -m "not research and not slow" >/dev/null 2>&1 || {
  echo "pre-commit: tests fail. Run: make test"
  exit 1
}
