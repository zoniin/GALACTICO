    {"key": "planted_order_only", "population_spearman": 0.95, "wyscout_scale": 1.5, "required_tokens": ["COMPARABLE_IN_RANK_ONLY"], "minimum_share": 0.95, "forbidden_tokens": ["COMPARABLE"]},
    {"key": "planted_null", "population_spearman": 0.0, "wyscout_scale": 1.0, "required_tokens": ["NOT_COMPARABLE"], "minimum_share": 0.95, "forbidden_tokens": ["COMPARABLE", "COMPARABLE_IN_RANK_ONLY"]},
    {"key": "planted_moderate", "population_spearman": 0.60, "wyscout_scale": 1.0, "required_tokens": ["NOT_COMPARABLE"], "minimum_share": 0.90, "forbidden_tokens": ["COMPARABLE", "COMPARABLE_IN_RANK_ONLY"]},
    {"key": "planted_boundary", "population_spearman": 0.80, "wyscout_scale": 1.0, "limited_tokens": ["COMPARABLE", "COMPARABLE_IN_RANK_ONLY"], "maximum_share": 0.10, "second_limited_tokens": ["NOT_COMPARABLE"], "second_maximum_share": 0.10},
