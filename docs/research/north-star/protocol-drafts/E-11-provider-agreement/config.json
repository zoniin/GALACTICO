    {"key": "goal_kick", "time_tolerance_seconds": 10.0, "distance_tolerance_m": null},
    {"key": "clearance", "time_tolerance_seconds": 5.0, "distance_tolerance_m": 20.0},
    {"key": "foul", "time_tolerance_seconds": 5.0, "distance_tolerance_m": 20.0}
  ],
  "count_only_families": ["interception", "ground_defending_duel", "statsbomb_one_sided", "wyscout_one_sided", "wyscout_unattributed_rows"],

  "acceptance_corpora": 200,
  "acceptance_bootstrap_replicates": 500,
  "acceptance_seed": 20261010,
  "acceptance_players": 219,
  "acceptance_matches": [64, 36],
  "acceptance_scenarios": [
